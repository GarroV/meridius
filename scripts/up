#!/usr/bin/env bash
# Одна команда, поднимающая продукт на локальной площадке (T050): база в Docker,
# миграции, демонстрационный контур, сборка и запуск. После неё остаётся только
# открыть напечатанный адрес.
#
#   ./scripts/up          (или npm run up)
#
# Ничего не спрашивает и ничего не сносит: повторный запуск доводит стенд до того же
# состояния. База переживает перезапуск — её том живёт в Docker.
set -euo pipefail
cd "$(dirname "$0")/.."

BOLD=$'\033[1m'; GREEN=$'\033[32m'; RED=$'\033[31m'; OFF=$'\033[0m'
step() { printf '\n%s▸ %s%s\n' "$BOLD" "$1" "$OFF"; }
die()  { printf '%sПРОВАЛ: %s%s\n' "$RED" "$1" "$OFF" >&2; exit 1; }

# Значение из файла окружения, не исполняя его: `source .env` отдал бы файлу оболочку.
value_from() {
  local file="$1" key="$2" fallback="${3-}" line
  line="$(grep -E "^[[:space:]]*${key}=" "$file" 2>/dev/null | tail -1 || true)"
  [ -z "$line" ] && { printf '%s' "$fallback"; return; }
  printf '%s' "${line#*=}"
}
env_value() { value_from .env "$1" "$2"; }

# Заменить значение в .env, не печатая его: секрет в выводе команды остался бы в журнале.
set_env_value() {
  local key="$1" value="$2" tmp
  tmp="$(mktemp)"
  grep -v -E "^[[:space:]]*${key}=" .env > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  cat "$tmp" > .env
  rm -f "$tmp"
}

# Значение то же, что опубликовано в .env.example? Сравниваем с самим файлом, а не с
# копией константы: константы в двух местах разъезжаются, а файл — источник истины.
same_as_example() {
  [ "$(env_value "$1" "")" = "$(value_from .env.example "$1" "")" ]
}

command -v docker >/dev/null 2>&1 || die "нет docker — база продукта живёт в контейнере"

if [ ! -f .env ]; then
  step "Окружения нет — беру пример"
  cp .env.example .env
  printf 'Создан .env из .env.example.\n'
fi

# Продукт ОТКАЗЫВАЕТ во входе, если секрет подписи или хэш пароля взяты из .env.example:
# файл лежит в git, и на боевом запуске (`next start` — это NODE_ENV=production) такие
# значения открыли бы кабинет любому читателю репозитория (см. src/blocks/auth/config.ts).
# Без замены стенд поднимался «успешно», страницы отдавали 200, а вход отвечал пятисоткой
# `SESSION_SECRET: значение взято из .env.example` — то есть одной командой поднимался
# стенд, на котором нельзя работать. Поэтому опубликованные значения здесь заменяются
# своими, а не оставляются с напоминанием: напоминание читают после того, как упёрлись.
if same_as_example SESSION_SECRET; then
  step "Секрет подписи сессии — свой"
  command -v openssl >/dev/null 2>&1 || die "нет openssl — нечем сгенерировать SESSION_SECRET"
  set_env_value SESSION_SECRET "$(openssl rand -base64 48 | tr -d '\n')"
  printf 'Секрет из .env.example заменён своим (в вывод не печатается).\n'
fi

if same_as_example ADMIN_PASSWORD_HASH; then
  step "Пароль кабинета — свой"
  command -v openssl >/dev/null 2>&1 || die "нет openssl — нечем сгенерировать пароль"
  NEW_ADMIN_PASSWORD="$(openssl rand -base64 18 | tr -d '\n/+=' | cut -c1-16)"
  NEW_HASH_LINE="$(printf '%s' "$NEW_ADMIN_PASSWORD" | node scripts/hash-admin-password.mjs)" \
    || die "не удалось посчитать хэш пароля"
  set_env_value ADMIN_PASSWORD_HASH "${NEW_HASH_LINE#*=}"
fi

# Порт приложения считает один общий источник (src/blocks/core/app-port.ts): своя
# копия разбора здесь была половиной дефекта #71 — `npm run dev` и `npm run start`
# уходили на литерал, а этот путь уважал .env, и расхождение не было видно ничем.
PORT="$(node scripts/app-port.mjs)" || die "не удалось определить порт приложения"
DB_PORT="$(env_value DB_PORT 5433)"
PROJECT="${COMPOSE_PROJECT_NAME:-$(env_value COMPOSE_PROJECT_NAME meridius)}"
URL="http://localhost:${PORT}"

# Порт задан дважды — контейнеру через DB_PORT и продукту внутри DATABASE_URL. Разошлись
# они молча: контейнер встаёт на один порт, продукт идёт на другой, а на другом у соседней
# копии стоит её база, и ответ приходит оттуда (T101). Поэтому расхождение — отказ.
DB_URL_PORT="$(env_value DATABASE_URL '' | sed -n 's#^[^/]*//[^/]*:\([0-9]\{1,5\}\)/.*#\1#p')"
if [ -n "$DB_URL_PORT" ] && [ "$DB_URL_PORT" != "$DB_PORT" ]; then
  die "в .env DB_PORT=$DB_PORT, а DATABASE_URL смотрит на порт $DB_URL_PORT — база поднимется не там, куда пойдёт продукт"
fi

if [ ! -d node_modules ]; then
  step "Зависимости"
  npm ci
fi

step "База ($PROJECT, порт $DB_PORT)"
docker compose -p "$PROJECT" up -d db

printf 'Жду готовности базы'
for _ in $(seq 1 60); do
  state="$(docker inspect -f '{{.State.Health.Status}}' "${PROJECT}-db-1" 2>/dev/null || echo starting)"
  [ "$state" = "healthy" ] && break
  printf '.'
  sleep 1
done
[ "${state:-}" = "healthy" ] || die "база не поднялась за минуту (docker compose -p $PROJECT logs db)"
printf ' готова\n'

# Ответить может и чужой стенд: имя рабочей базы у всех копий одно, порт по умолчанию тоже.
# Метка в самой базе — единственное, чем свой сервер отличается от соседского (T101).
step "Свой ли стенд"
node scripts/assert-own-stand.mjs || exit 1

step "Миграции"
npm run --silent db:migrate

step "Демонстрационный контур"
node scripts/seed-demo.mjs

step "Сборка"
# Сборка запекает значения переменных окружения (D033), поэтому идёт после .env,
# а не один раз на все запуски.
npx --no-install next build

printf '\n%sПродукт поднят: %s%s\n' "$GREEN" "$URL" "$OFF"
printf 'Админка: %s/admin · экран заполнения открывается по ссылке станции из вывода сида.\n' "$URL"
# Пароль печатается ровно один раз и только когда его завёл этот запуск: нигде больше
# его нет (в .env лежит хэш), а стенд без пароля — это стенд, на который нельзя войти.
if [ -n "${NEW_ADMIN_PASSWORD:-}" ]; then
  printf '%sПароль кабинета (запишите, второй раз он не покажется): %s%s\n' \
    "$BOLD" "$NEW_ADMIN_PASSWORD" "$OFF"
  printf 'Сменить: node scripts/hash-admin-password.mjs, затем ADMIN_PASSWORD_HASH в .env и пересборка.\n'
fi
printf 'Остановить: Ctrl-C. Убрать базу: docker compose -p %s down -v\n\n' "$PROJECT"

# Тот же запускатель, что у `npm run start`: два способа поднять продукт — это два
# способа разойтись.
exec node scripts/next-app.mjs start
