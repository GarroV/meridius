// ШАБЛОН конфига фронта открытого демо (D194): https://meridius-demo.vasiliy-garro.workers.dev
// Код у Worker'а тот же, что у прода (`front/src/index.js`), отличаются имя и адрес сервера.
// Рабочий конфиг собирается на машине выкладки из этого шаблона: <DEMO_ORIGIN_HOST> —
// имя сайта демо в Caddy, <VPC_SERVICE_ID> — сервис vps-edge-caddy из учётки Cloudflare
// (тот же, что в `wrangler.jsonc`). Адреса инфраструктуры сюда не вписываются.
// Выкладка: `npx wrangler deploy -c wrangler.demo.jsonc` из `front/`.
// Ключ фронта — свой, случайный, секретом: без него Worker отвечает 503 и ничего не пересылает:
//   openssl rand -hex 32 | npx wrangler secret put FRONT_KEY --name meridius-demo
// Сайт демо в Caddy ключ не проверяет (как стенд), заголовки фронта он срезает: секрет
// нужен Worker'у, чтобы пересылать, и вне git.
{
  "name": "meridius-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vpc_services": [{ "binding": "EDGE", "service_id": "<VPC_SERVICE_ID>" }],
  "vars": { "ORIGIN_HOST": "<DEMO_ORIGIN_HOST>" },
}
