#!/usr/bin/env bash
# Включается один раз: git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
if [ ! -x "$ROOT/scripts/check" ]; then
  echo "pre-push: нет scripts/check — пуш остановлен" >&2
  exit 1
fi
# Сквозные сценарии здесь не гоняются — их гоняет CI (D168, #173).
exec "$ROOT/scripts/check" --no-e2e
