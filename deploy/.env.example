# Окружение прода: скопировать в deploy/.env на сервере и заполнить. Значений здесь нет
# и не будет — файл лежит в git. Что означает каждый ключ и как считать значение —
# deploy/README.md, раздел «Окружение».
#
# Знак $ в значениях не используйте: compose раскрывает его как подстановку.

# ── База ─────────────────────────────────────────────────────
POSTGRES_USER=
# Только [A-Za-z0-9]: пароль подставляется в адрес подключения без экранирования.
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Адрес продукта (запекается в сборку) ─────────────────────
# Публичный адрес без завершающего /: он уходит ВНУТРЬ напечатанных QR-кодов.
PUBLIC_BASE_URL=
# Путь продукта на адресе: пусто — корень, иначе вида /qr.
BASE_PATH=

# ── Секреты входа ────────────────────────────────────────────
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
DEVICE_SESSION_SECRET=

# ── Прокси ───────────────────────────────────────────────────
# Число доверенных посредников перед продуктом. 0 — заголовок X-Forwarded-For не читается.
TRUSTED_PROXY_HOPS=

# Вход через Google (D176) — необязательно: пусто, и кнопки на экране входа нет.
# Клиент Meridius в Google Cloud (Web application, экран согласия External), адрес
# возврата: <PUBLIC_BASE_URL><BASE_PATH>/admin/login/google/callback. См. README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Адрес возврата для входа через фронт Cloudflare; пусто — через фронт тот же прямой.
GOOGLE_FRONT_REDIRECT_URI=
