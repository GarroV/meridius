# Окружение стенда открытого демо (D194): копируется в deploy/demo/.env на сервере, в
# /srv/meridius-demo; в git попадает только этот шаблон. Значения — свои, не боевые:
# с продом стенд не делит ни базу, ни секреты. Знак `$` в значениях не использовать.
# Подробно — deploy/README.md, «Открытое демо».

# Признак стенда демо: без него guard.sh отказывает, а вход /demo отвечает 404.
DEMO_MODE=1

# Своя база. Пароль только [A-Za-z0-9]: openssl rand -hex 24
POSTGRES_USER=meridius_demo
POSTGRES_PASSWORD=
POSTGRES_DB=meridius_demo

# Публичный адрес демо без завершающего «/» (адрес Worker'а демо). Запекается в сборку.
PUBLIC_BASE_URL=
BASE_PATH=

# Хэш пароля учётки `admin`: демо в неё не входит. Задать хэш от случайного пароля, который
# нигде не хранится: node scripts/hash-admin-password.mjs. Пароль не короче 12 знаков.
ADMIN_PASSWORD_HASH=
# Подпись cookie кабинета и планшета: openssl rand -hex 32, два РАЗНЫХ значения.
SESSION_SECRET=
DEVICE_SESSION_SECRET=

# Сколько доверенных посредников перед продуктом (Worker + Caddy), как у прода.
TRUSTED_PROXY_HOPS=1
